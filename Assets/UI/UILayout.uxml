    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 20px; justify-content: flex-start; align-items: stretch; align-self: center; font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); border-top-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 1px; border-top-left-radius: 5px; border-left-width: 1px; border-bottom-width: 1px; border-right-width: 1px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 30px; width: 133px; -unity-text-align: middle-center; -unity-background-image-tint-color: rgb(41, 37, 37); background-color: rgba(32, 32, 32, 0.455);"/>
